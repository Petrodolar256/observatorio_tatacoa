# PLANTILLA de configuración.
#
# 1. Copia este archivo con el nombre  .env
# 2. Cambia DB_PASSWORD por la contraseña de tu PostgreSQL
#
# El archivo .env NO se sube a GitHub (está en .gitignore),
# por eso tus credenciales reales nunca quedan publicadas.

# --- Conexión a PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=observatorio_tatacoa
DB_USER=postgres
DB_PASSWORD=escribe_aqui_tu_clave

# --- Clave de Flask (protege los mensajes que se muestran al usuario) ---
SECRET_KEY=cambia-esto-por-cualquier-texto-largo
